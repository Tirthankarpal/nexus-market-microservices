# ==============================================================================
# Nexus Market — Production Environment Configuration Template
# Instructions: Copy this file as '.env' on your Droplet and populate secrets.
# ==============================================================================

# --- Global Database Credentials ---
DB_USER=postgres_admin
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE

# --- Service Specific Database Names ---
AUTH_DB_NAME=nexus_auth
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db

# --- Security ---
# Generate a strong 256-bit hexadecimal string (e.g. openssl rand -hex 32)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# --- Infrastructure ---
EUREKA_PASSWORD=YOUR_SECURE_EUREKA_PASSWORD_HERE
# Eureka registry URL with credentials embedded
EUREKA_URL=http://eureka:YOUR_SECURE_EUREKA_PASSWORD_HERE@discovery-server:8761/eureka/
# Kafka connection endpoints inside Docker network
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
